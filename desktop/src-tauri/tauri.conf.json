{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polytopia Analyzer",
  "version": "0.8.1",
  "identifier": "io.github.koffeny301.polytopia-analyzer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Polytopia Analyzer",
        "url": "index.html",
        "width": 1320,
        "height": 880,
        "minWidth": 940,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/polytopia-analyzer"],
    "category": "Game",
    "shortDescription": "Анализ матчей The Battle of Polytopia",
    "longDescription": "Анализ матчей The Battle of Polytopia с HTML-отчётами: динамика счёта, боевая статистика, смена лидеров. Два режима: автоматический (шим для реплеев в Steam, Linux) и ручной (импорт сейвов одиночной игры и CSV-таблиц).",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      }
    }
  }
}
